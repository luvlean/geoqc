# python
.venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/
# env
.env
# data: keep manifests, labels and small indexes; ignore rasters and big artifacts
data/raw/*
data/interim/*
data/tiles/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/tiles/.gitkeep
!data/manifest.json
!data/tiles/tiles.gpkg
data/labels/**/*.tif
# external datasets, downloaded by hand (URLs: docs/datasets/*.md); already under data/raw/*, kept explicit
data/raw/external/
# models
models/*
!models/.gitkeep
!models/MODEL_CARD.md
# reports: keep json/md/png, ignore heavy dumps
reports/**/*.gpkg
reports/**/*.parquet
# figures are regenerated by `geoqc eval error-analysis`
reports/figures/
# os
.DS_Store

# runtime logs
logs/

# analysis figures: regenerated by notebooks/airs_eda.ipynb and notebooks/experiments.ipynb,
# which keep them embedded in their outputs
docs/datasets/figures/airs_*
docs/figures/experiments_*
