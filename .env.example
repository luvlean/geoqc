# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=geoqc
POSTGRES_PASSWORD=geoqc
POSTGRES_DB=geoqc
# Host port (5432 is taken by Postgres.app on this machine)
POSTGRES_PORT=5433
DATABASE_URL=postgresql://geoqc:geoqc@localhost:5433/geoqc
TEST_DATABASE_URL=postgresql://geoqc:geoqc@localhost:5433/geoqc_test
# Esri World Imagery basemap key (visual reference only, see DECISIONS.md D-002)
ARCGIS_API_KEY=
# Root of the data directory (relative to repo root or absolute)
GEOQC_DATA_DIR=data
